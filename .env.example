# Network selection: testnet | mainnet
PERPL_NETWORK=testnet

# Overrides (auto-derived from PERPL_NETWORK if left blank)
PERPL_API_URL=
PERPL_WS_URL=
PERPL_CHAIN_ID=

# Origin used for API key enrollment - must be whitelisted by Perpl beforehand
PERPL_ORIGIN=http://localhost

# Only needed once, to run scripts/enroll-key.ts. Remove from .env after enrolling.
# This is your trading wallet's private key (secp256k1) - never commit it.
WALLET_PRIVATE_KEY=

# Filled in by scripts/enroll-key.ts after enrollment
PERPL_API_KEY=
PERPL_API_KEY_SECRET=

# Identifies this process when running several instances side by side (e.g.
# one per wallet) - keeps each instance's cycle log separate
# (logs/cycles.<label>.jsonl). Leave blank for a single-instance setup.
BOT_LABEL=

# Trading parameters
# Mainnet market ids: BTC=1, MON=10, ETH=20, SOL=31, HYPE=40, ZEC=50
# (testnet ids differ: BTC=16, ETH=32, SOL=48, MON=64, ZEC=256)
# SOL picked for its current 2x points boost + deepest OI among boosted markets - re-check
# with rank-markets analysis if boosts have rotated by the time you read this.
MARKET_ID=31
NOTIONAL_USD=2500
LEVERAGE=10
MAKER_TIMEOUT_MS=4000
MAKER_CHASE_ATTEMPTS=5
CHASE_RETRY_BACKOFF_MS=250
# Opens pay fees: false = maker-only opens (failed chase just skips the cycle, costs nothing)
OPEN_TAKER_FALLBACK=false
# Closes are always free: false = instant IOC market close (only cost is ~0.1bps half-spread)
CLOSE_MAKER_FIRST=false
MAX_TAKER_SLIPPAGE_BPS=15
ORDER_EXPIRY_BLOCKS=15
HARD_TIMEOUT_MS=15000
POSITION_CONFIRM_TIMEOUT_MS=25000
# 0 = run until Ctrl+C
TARGET_VOLUME_USD=50000
# 0 = no time limit; otherwise stop cleanly after N minutes. MAX_RUNTIME_HOURS
# is more convenient for multi-hour runs and wins over this if set (nonzero).
MAX_RUNTIME_MIN=0
MAX_RUNTIME_HOURS=
CYCLE_REST_MS=1000
# Optional: if BOTH set, the rest between cycles is randomized in this range
# instead of the fixed CYCLE_REST_MS above. Vary this (and NOTIONAL_USD) across
# accounts running side by side so their cadence/size don't look identical -
# reduces (does not eliminate) wash-trading/Sybil correlation risk.
CYCLE_REST_MIN_MS=
CYCLE_REST_MAX_MS=
# Trend guard: skip opening while |mid drift| over the window exceeds this (0 = off)
TREND_GUARD_WINDOW_MS=10000
TREND_GUARD_MAX_DRIFT_BPS=3.5

# Mid-chase abort: unlike the trend guard above (checked once, before a cycle
# starts), this watches for the touch moving against us DURING a chase, attempt
# after attempt, and bails out early instead of paying an increasingly bad price
# to keep chasing a trend. Requires CHASE_ABORT_CONFIRM_ATTEMPTS consecutive
# adverse reprices (not just one) before acting, so a single noisy tick doesn't
# trigger it. Set CHASE_ABORT_DRIFT_BPS to 0 to disable.
CHASE_ABORT_DRIFT_BPS=3.5
CHASE_ABORT_CONFIRM_ATTEMPTS=2
