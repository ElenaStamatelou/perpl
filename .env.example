# Network selection: testnet | mainnet
PERPL_NETWORK=mainnet

# Overrides (auto-derived from PERPL_NETWORK if left blank)
PERPL_API_URL=
PERPL_WS_URL=
PERPL_CHAIN_ID=

# Origin used for API key enrollment - must be whitelisted by Perpl beforehand
PERPL_ORIGIN=http://localhost

# Pin to a specific account id. Leave blank to use the wallet's first account.
PERPL_ACCOUNT_ID=

# Only needed once, to run scripts/enroll-key.ts. Remove from .env after enrolling.
# This is your trading wallet's private key (secp256k1) - never commit it.
WALLET_PRIVATE_KEY=

# Filled in by scripts/enroll-key.ts after enrollment
PERPL_API_KEY=
PERPL_API_KEY_SECRET=

# Trading parameters
# Mainnet market ids: BTC=1, MON=10, ETH=20, SOL=31, HYPE=40, ZEC=50
# (testnet ids differ: BTC=16, ETH=32, SOL=48, MON=64, ZEC=256)
# Currently trading BTC for its deeper book (~$33M/day vs SOL's ~$5.8M) - no fee/boost
# difference between them (both 0.90/6.90bps, 0bps boost, as of the last check).
# Re-check periodically if boosts/liquidity have shifted by the time you read this.
MARKET_ID=1
# Sized for max volume/hour at a ~$800 AUSD balance: BTC's book swallows a $400 clip without
# walking the touch, keeping maker-fill rate/blended fee bps the same as smaller sizes while
# roughly doubling $/hour (fixed per-cycle overhead). Scale with your actual balance.
NOTIONAL_USD=400
LEVERAGE=10
MAKER_TIMEOUT_MS=8000
MAKER_CHASE_ATTEMPTS=5
CHASE_RETRY_BACKOFF_MS=250
# Opens pay fees: false = maker-only opens (failed chase just skips the cycle, costs nothing)
OPEN_TAKER_FALLBACK=false
# Closes are always free: false = instant IOC market close (only cost is ~0.1bps half-spread)
CLOSE_MAKER_FIRST=false
MAX_TAKER_SLIPPAGE_BPS=15
ORDER_EXPIRY_BLOCKS=18
HARD_TIMEOUT_MS=15000
POSITION_CONFIRM_TIMEOUT_MS=25000
# 0 = run until Ctrl+C / pm2 stop (no volume cap)
TARGET_VOLUME_USD=0
# 0 = no time limit; otherwise stop cleanly after N minutes/hours. MAX_RUNTIME_HOURS
# is more convenient for multi-hour runs and wins over MAX_RUNTIME_MIN if set (nonzero).
MAX_RUNTIME_HOURS=0
MAX_RUNTIME_MIN=0
CYCLE_REST_MS=1000
# Both set: rest between cycles is jittered in this range instead of the fixed
# CYCLE_REST_MS above - more cycles/hour at zero fee cost.
CYCLE_REST_MIN_MS=200
CYCLE_REST_MAX_MS=700
# Trend guard: skip opening while |mid drift| over the window exceeds this (0 = off)
TREND_GUARD_WINDOW_MS=10000
TREND_GUARD_MAX_DRIFT_BPS=3.5

# Mid-chase abort: unlike the trend guard above (checked once, before a cycle
# starts), this watches for the touch moving against us DURING a chase, attempt
# after attempt, and bails out early instead of paying an increasingly bad price
# to keep chasing a trend. Requires CHASE_ABORT_CONFIRM_ATTEMPTS consecutive
# adverse reprices (not just one) before acting, so a single noisy tick doesn't
# trigger it. Set CHASE_ABORT_DRIFT_BPS to 0 to disable.
CHASE_ABORT_DRIFT_BPS=3.5
CHASE_ABORT_CONFIRM_ATTEMPTS=2

# Optional: push a summary message every ~12h via ntfy.sh (no account/token needed).
# Pick your own hard-to-guess topic name (anyone who knows the exact name can read
# it, since public ntfy topics aren't private), then subscribe to that same name in
# the ntfy app (+ Add subscription) or by opening https://ntfy.sh/<topic> in a browser.
# Example: NTFY_TOPIC=perpl-bot-k9x2mq7
# Leave blank to disable.
NTFY_TOPIC=
# Two push cadences, both only checked when a cycle closes (so the real gap rounds
# up to the next cycle): SUMMARY is a frequent pulse (ntfy only), REPORT is the
# fuller one that also appends a row to logs/summary-12h.xlsx.
SUMMARY_INTERVAL_HOURS=2
REPORT_INTERVAL_HOURS=12
