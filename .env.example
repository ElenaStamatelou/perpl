# Network selection: testnet | mainnet
PERPL_NETWORK=mainnet

# Overrides (auto-derived from PERPL_NETWORK if left blank)
PERPL_API_URL=
PERPL_WS_URL=
PERPL_CHAIN_ID=

# Origin used for API key enrollment - must be whitelisted by Perpl beforehand
PERPL_ORIGIN=http://localhost

# Pin to a specific account id. Leave blank to use the wallet's first account.
PERPL_ACCOUNT_ID=

# Only needed once, to run scripts/enroll-key.ts. Remove from .env after enrolling.
# This is your trading wallet's private key (secp256k1) - never commit it.
WALLET_PRIVATE_KEY=

# Filled in by scripts/enroll-key.ts after enrollment
PERPL_API_KEY=
PERPL_API_KEY_SECRET=

# Trading parameters
# Mainnet market ids: BTC=1, MON=10, ETH=20, SOL=31, HYPE=40, ZEC=50
# (testnet ids differ: BTC=16, ETH=32, SOL=48, MON=64, ZEC=256)
# Currently trading BTC for its deeper book (~$33M/day vs SOL's ~$5.8M) - no fee/boost
# difference between them (both 0.90/6.90bps, 0bps boost, as of the last check).
# Re-check periodically if boosts/liquidity have shifted by the time you read this.
MARKET_ID=1
# Sized for max volume/hour at a ~$800 AUSD balance: BTC's book swallows a $400 clip without
# walking the touch, keeping maker-fill rate/blended fee bps the same as smaller sizes while
# roughly doubling $/hour (fixed per-cycle overhead). Scale with your actual balance.
NOTIONAL_USD=400
LEVERAGE=10
MAKER_TIMEOUT_MS=8000
MAKER_CHASE_ATTEMPTS=5
CHASE_RETRY_BACKOFF_MS=250
# Opens pay fees: false = maker-only opens (failed chase just skips the cycle, costs nothing)
OPEN_TAKER_FALLBACK=false
# Closes are always free: false = instant IOC market close (only cost is ~0.1bps half-spread)
CLOSE_MAKER_FIRST=false
MAX_TAKER_SLIPPAGE_BPS=15
ORDER_EXPIRY_BLOCKS=18
HARD_TIMEOUT_MS=15000
POSITION_CONFIRM_TIMEOUT_MS=25000
# 0 = run until Ctrl+C / pm2 stop (no volume cap)
TARGET_VOLUME_USD=0
# 0 = no time limit; otherwise stop cleanly after N minutes/hours. MAX_RUNTIME_HOURS
# is more convenient for multi-hour runs and wins over MAX_RUNTIME_MIN if set (nonzero).
MAX_RUNTIME_HOURS=0
MAX_RUNTIME_MIN=0
CYCLE_REST_MS=1000
# Both set: rest between cycles is jittered in this range instead of the fixed
# CYCLE_REST_MS above - more cycles/hour at zero fee cost.
CYCLE_REST_MIN_MS=200
CYCLE_REST_MAX_MS=700
# Trend guard: skip opening while |mid drift| over the window exceeds this (0 = off)
TREND_GUARD_WINDOW_MS=10000
TREND_GUARD_MAX_DRIFT_BPS=3.5

# Mid-chase abort: unlike the trend guard above (checked once, before a cycle
# starts), this watches for the touch moving against us DURING a chase, attempt
# after attempt, and bails out early instead of paying an increasingly bad price
# to keep chasing a trend. Requires CHASE_ABORT_CONFIRM_ATTEMPTS consecutive
# adverse reprices (not just one) before acting, so a single noisy tick doesn't
# trigger it. Set CHASE_ABORT_DRIFT_BPS to 0 to disable.
CHASE_ABORT_DRIFT_BPS=3.5
CHASE_ABORT_CONFIRM_ATTEMPTS=2

# Cost ladder: trade full size only while it's cheap, shrink when it isn't.
# Measures all-in cost (fees - PnL) per $1M over the last COST_LADDER_CYCLES cycles
# and maps it to notional on a CONTINUOUS LINEAR SCALE (2026-09-08, replacing an
# earlier 3-rung step function):
#   <= TIER1  -> NOTIONAL_USD (full size)
#   >= TIER2  -> COST_LADDER_NOTIONAL_FLOOR
#   between   -> straight line from full down to the floor
# A small cost move produces a small size move - no jumps, and no fixed "mid"
# size any more (there's no single midpoint on a line). Replayed over 25k
# historical cycles this kept 58% of the volume for 51% less burn ($64.01 ->
# $53.69 per $1M). It does NOT make individual trades cheaper - fees and spread
# are percentages - it just weights volume toward cheap conditions. So it is
# only worth running if the points earned on the volume you give up are worth
# less than ~$80/$1M. Check with: npx tsx scripts/replay-ladder.ts
#
# The window is a cycle COUNT, not minutes: a wall-clock window empties whenever the
# bot skips cycles and would fall back to full size exactly when the market is
# trending/unstable and expensive (27% of cycles in the logs). 70 cycles is ~1h at
# the observed pace (raised from an initial 12 (~10 min) on 2026-09-08 - a live
# WebSocket-instability episode showed 12 flapping ~1 per 8 cycles; 70 cuts that to
# ~1 per 29 with no material change to the historical outcome). The floor keeps
# trading rather than stopping, so the metric stays live and the ladder can climb
# back on its own. Set COST_LADDER_CYCLES=0 to disable.
# NOTE: the floor is raised at runtime to the market's own min_posting_amount if
# that is larger - the bot logs the effective floor on the first change.
#
# Since notional now moves every cycle, logging/ntfy is throttled separately:
# only fires once it's moved at least COST_LADDER_NOTIFY_STEP_USD since the last
# announcement. $75 reproduces the old step-function's ~1-per-29-cycles cadence.
COST_LADDER_CYCLES=70
COST_LADDER_TIER1_USD_PER_M=60
COST_LADDER_TIER2_USD_PER_M=70
COST_LADDER_NOTIONAL_FLOOR=3
COST_LADDER_NOTIFY_STEP_USD=75
# Minimum wall-clock gap between two "notional changed" pushes. The step check
# alone can trip on back-to-back cycles (seconds apart) and fire two near-identical
# pushes in the same minute; this caps them at one per N seconds, with the next
# push reporting the whole move since the last one sent (nothing lost, just
# coalesced). Only the push is gated - the log line and cost_ladder event are not.
# 0 = no time gate. Raise it (600-900) if you also widen the curve below.
COST_LADDER_NOTIFY_MIN_INTERVAL_SEC=300
#
# COST_LADDER_POINTS: optional multi-breakpoint curve that REPLACES the TIER1/TIER2
# straight line above. Format: "cost:notional" pairs (cost in $/1M, notional in $
# per leg), comma-separated, any order. At/below the lowest cost the largest
# notional applies; at/above the highest cost the smallest applies; every segment
# in between is linear. TIER1/TIER2/NOTIONAL_USD are ignored for the curve shape
# while this is set (NOTIONAL_USD is still the "up to $X" shown in the connect
# push, so set it to the curve's top). The min_posting_amount floor still applies.
# Example - full $5000 at cheap, collapsing to $3 by $70/1M:
# COST_LADDER_POINTS=50:5000,60:2000,65:500,70:3

# Optional: push a summary message every ~12h via ntfy.sh (no account/token needed).
# Pick your own hard-to-guess topic name (anyone who knows the exact name can read
# it, since public ntfy topics aren't private), then subscribe to that same name in
# the ntfy app (+ Add subscription) or by opening https://ntfy.sh/<topic> in a browser.
# Example: NTFY_TOPIC=perpl-bot-k9x2mq7
# Leave blank to disable.
NTFY_TOPIC=
# Two push cadences, both only checked when a cycle closes (so the real gap rounds
# up to the next cycle): REPORT covers only the past N hours (ntfy + a row appended
# to logs/summary-12h.xlsx); FULL_SUMMARY is the "since start" totals, ntfy only.
REPORT_INTERVAL_HOURS=12
FULL_SUMMARY_INTERVAL_HOURS=24
